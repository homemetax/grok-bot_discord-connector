{
  "webhook_key_header": "Authorization",
  "history_limit": 20,
  "enable_dms": false,
  "webhook_timeout_ms": 30000,
  "loop_guard": {
    "max_bot_exchanges": 6,
    "window_ms": 120000,
    "cooldown_ms": 8000
  },
  "data_dir": "./data",
  "agents": [
    {
      "name": "GrokBot",
      "token_env": "GROKBOT_DISCORD_TOKEN",
      "webhook_url_env": "GROKBOT_WEBHOOK_URL",
      "webhook_key_env": "GROKBOT_WEBHOOK_KEY",
      "per_author_daily_limit": 1,
      "rate_limit_exempt_author_ids": ["200000000000000001"],
      "mention_mode": "user_only"
    },
    {
      "name": "agent-1",
      "token_env": "AGENT_1_DISCORD_TOKEN",
      "webhook_url_env": "AGENT_1_WEBHOOK_URL",
      "webhook_key_env": "AGENT_1_WEBHOOK_KEY"
    },
    {
      "name": "agent-2",
      "token_env": "AGENT_2_DISCORD_TOKEN",
      "webhook_url_env": "AGENT_2_WEBHOOK_URL",
      "webhook_key_env": "AGENT_2_WEBHOOK_KEY",
      "allowed_channel_ids": ["100000000000000001"],
      "enable_dms": false,
      "history_limit": 30
    }
  ]
}
