[Unit]
Description=Grok Bot Discord connector (all agents in one process)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=grokdiscord
Group=grokdiscord
WorkingDirectory=/opt/grok-bot-discord-connector
Environment=NODE_ENV=production
Environment=CONFIG_PATH=/opt/grok-bot-discord-connector/config/agents.json
EnvironmentFile=-/opt/grok-bot-discord-connector/.env
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5
# Do not dump the environment on failure (tokens live there).
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
