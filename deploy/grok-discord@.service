[Unit]
Description=Grok Bot Discord connector for agent %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=grokdiscord
Group=grokdiscord
WorkingDirectory=/opt/grok-bot-discord-connector
Environment=NODE_ENV=production
Environment=CONFIG_PATH=/opt/grok-bot-discord-connector/config/agents.json
Environment=DISCORD_AGENT=%i
EnvironmentFile=-/opt/grok-bot-discord-connector/.env
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
