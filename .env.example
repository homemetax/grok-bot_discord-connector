# Copy to .env and fill in values. Never commit .env.
# Secrets are read only from process.env. Do not put tokens in config files.

# Optional. Defaults to ./config/agents.json
# CONFIG_PATH=/opt/grok-bot-discord-connector/config/agents.json

# Optional. When set, this process runs only that agent (one process per bot).
# Unset = all agents in config (multi-client in one process).
# DISCORD_AGENT=GrokBot

# Optional. Directory for persisted connector state (author daily counts).
# Default: ./data (gitignored). Override config data_dir.
# DATA_DIR=./data

# --- GrokBot ---
GROKBOT_DISCORD_TOKEN=
GROKBOT_WEBHOOK_URL=
GROKBOT_WEBHOOK_KEY=

# --- agent-1 ---
AGENT_1_DISCORD_TOKEN=
AGENT_1_WEBHOOK_URL=
AGENT_1_WEBHOOK_KEY=

# --- agent-2 ---
AGENT_2_DISCORD_TOKEN=
AGENT_2_WEBHOOK_URL=
AGENT_2_WEBHOOK_KEY=
