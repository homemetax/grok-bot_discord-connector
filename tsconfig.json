{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "ES2022",
    "module": "CommonJS",
    "skipLibCheck": true
  },
  "include": [
    "bin/**/*.js",
    "src/**/*.js",
    "test/**/*.js",
    "scripts/**/*.js",
    "deploy/**/*.js",
    "eslint.config.js"
  ],
  "exclude": ["node_modules"]
}
