{
  "name": "grok-bot-discord-connector",
  "version": "1.0.0",
  "description": "Discord connector that bridges Grok Bot agents (GrokBot, agent-1, agent-2, ...) to Discord using one bot application per agent.",
  "main": "src/index.js",
  "bin": {
    "grok-discord": "bin/discord.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "setup": "bash scripts/setup.sh",
    "add-agent": "bash scripts/add-agent.sh",
    "start:pm2": "bash scripts/start.sh",
    "test": "node --test test/*.test.js",
    "cli": "node bin/discord.js"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "discord.js": "^14.16.3"
  },
  "license": "UNLICENSED",
  "private": true
}
